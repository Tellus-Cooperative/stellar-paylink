# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Database
# Leave empty to use the zero-setup in-memory store.
# Set a PostgreSQL DSN (e.g. Neon) to persist links, then run `pnpm db:migrate`.
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Asset Configuration (USDC)
# Canonical Circle USDC issuer on Stellar Testnet (see
# https://developers.circle.com/stablecoins/usdc-contract-addresses).
# Leave empty to disable credit assets and keep XLM only.
# Must be a valid G... address when set.
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
